---
// astro_sid/src/layouts/Layout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';

const { title } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title || "Profil Desa Sukamaju"}</title>
  </head>
  <body class="bg-gray-100 text-gray-800 font-sans pb-16 min-h-screen">
    <!-- Container Utama Dibatasi Ukuran Mobile (max-w-md) -->
    <div class="max-w-md mx-auto min-h-screen bg-white shadow-sm flex flex-col">
      <Header />
      
      <main class="flex-1 p-4">
        <slot />
      </main>

      <BottomNav />
    </div>
  </body>
</html>