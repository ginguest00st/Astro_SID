---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Kepengurusan - Desa Sukamaju">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-[10px] text-gray-500 uppercase tracking-[0.3em]">Dashboard</p>
        <h1 class="text-lg font-bold text-gray-900">Kepengurusan Desa</h1>
      </div>
      <span class="text-[11px] bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full">Terbaru</span>
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
        <p class="text-[10px] text-gray-500">Ketua</p>
        <p class="mt-3 text-sm font-semibold text-gray-900">Slamet Riyadi</p>
      </div>
      <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
        <p class="text-[10px] text-gray-500">Sekretaris</p>
        <p class="mt-3 text-sm font-semibold text-gray-900">Nina Kurniawati</p>
      </div>
      <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
        <p class="text-[10px] text-gray-500">Bendahara</p>
        <p class="mt-3 text-sm font-semibold text-gray-900">Hendra Saputra</p>
      </div>
      <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
        <p class="text-[10px] text-gray-500">Jumlah Pengurus</p>
        <p class="mt-3 text-sm font-semibold text-gray-900">18 Orang</p>
      </div>
    </div>

    <section class="space-y-3">
      <div class="flex justify-between items-center">
        <h2 class="text-xs font-semibold text-gray-700">Struktur Organisasi</h2>
        <a href="/" class="text-[10px] text-emerald-700 font-semibold">Kembali</a>
      </div>
      <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4 space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-[10px] text-gray-500">Bidang Pemerintahan</span>
          <span class="text-[10px] text-emerald-700 font-semibold">6 Orang</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[10px] text-gray-500">Bidang Pembangunan</span>
          <span class="text-[10px] text-emerald-700 font-semibold">5 Orang</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-[10px] text-gray-500">Bidang Kemasyarakatan</span>
          <span class="text-[10px] text-emerald-700 font-semibold">7 Orang</span>
        </div>
      </div>
    </section>

    <section class="space-y-2">
      <h2 class="text-xs font-semibold text-gray-700">Aksi Cepat</h2>
      <div class="grid grid-cols-2 gap-2 text-xs text-center">
        <a href="/profil" class="block bg-emerald-50 rounded-2xl py-3 border border-emerald-100 hover:bg-emerald-100 transition">Profil Desa</a>
        <a href="/berita" class="block bg-emerald-50 rounded-2xl py-3 border border-emerald-100 hover:bg-emerald-100 transition">Berita</a>
        <a href="/pelayanan" class="block bg-emerald-50 rounded-2xl py-3 border border-emerald-100 hover:bg-emerald-100 transition">Pelayanan</a>
        <a href="/" class="block bg-emerald-50 rounded-2xl py-3 border border-emerald-100 hover:bg-emerald-100 transition">Beranda</a>
      </div>
    </section>
  </div>
</Layout>
