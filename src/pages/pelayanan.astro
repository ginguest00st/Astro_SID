---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pelayanan - Desa Sukamaju">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-[10px] text-gray-500 uppercase tracking-[0.3em]">Dashboard</p>
        <h1 class="text-lg font-bold text-gray-900">Pelayanan Publik</h1>
      </div>
      <span class="text-[11px] bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full">Jam Layanan</span>
    </div>

    <div class="space-y-3">
      <div class="flex items-center justify-between rounded-3xl border border-emerald-100 bg-emerald-50 p-4">
        <div>
          <p class="text-[10px] text-emerald-700 uppercase">Senin - Jumat</p>
          <p class="text-sm font-semibold text-emerald-900">08:00 - 15:00</p>
        </div>
        <span class="text-[10px] bg-white text-emerald-700 px-3 py-1 rounded-full border border-emerald-100">Offline</span>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
          <p class="text-[10px] text-gray-500">KTP</p>
          <p class="mt-3 text-sm font-semibold text-gray-900">Pembuatan & Perpanjangan</p>
        </div>
        <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
          <p class="text-[10px] text-gray-500">KK</p>
          <p class="mt-3 text-sm font-semibold text-gray-900">Kartu Keluarga</p>
        </div>
        <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
          <p class="text-[10px] text-gray-500">Domisili</p>
          <p class="mt-3 text-sm font-semibold text-gray-900">Surat Domisili</p>
        </div>
        <div class="p-4 bg-white rounded-3xl border border-gray-100 shadow-sm">
          <p class="text-[10px] text-gray-500">SKTM</p>
          <p class="mt-3 text-sm font-semibold text-gray-900">Keringanan Biaya</p>
        </div>
      </div>
    </div>

    <section class="space-y-3">
      <h2 class="text-xs font-semibold text-gray-700">Panduan Layanan</h2>
      <div class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4 space-y-3 text-[11px] text-gray-600">
        <div>
          <p class="font-semibold text-gray-800">1. Siapkan dokumen</p>
          <p class="mt-1">Fotokopi KTP, KK, dan surat pendukung sesuai jenis layanan.</p>
        </div>
        <div>
          <p class="font-semibold text-gray-800">2. Ajukan permohonan</p>
          <p class="mt-1">Kunjungi kantor desa atau ajukan via telepon/WhatsApp.</p>
        </div>
        <div>
          <p class="font-semibold text-gray-800">3. Tunggu proses</p>
          <p class="mt-1">Proses biasanya selesai dalam 1-3 hari kerja.</p>
        </div>
      </div>
    </section>

    <a href="/" class="inline-flex items-center justify-center w-full rounded-3xl bg-emerald-700 text-white py-3 text-sm font-semibold hover:bg-emerald-800 transition">Kembali ke Beranda</a>
  </div>
</Layout>
