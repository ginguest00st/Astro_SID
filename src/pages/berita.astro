---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Berita - Desa Sukamaju">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-[10px] text-gray-500 uppercase tracking-[0.3em]">Dashboard</p>
        <h1 class="text-lg font-bold text-gray-900">Berita Desa</h1>
      </div>
      <span class="text-[11px] bg-emerald-100 text-emerald-700 px-3 py-1 rounded-full">Update</span>
    </div>

    <div class="space-y-3">
      <article class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4">
        <div class="flex items-center justify-between text-[10px] text-gray-500 uppercase tracking-[0.2em] mb-3">
          <span>Pengumuman</span>
          <span>30 Juli 2026</span>
        </div>
        <h2 class="text-sm font-semibold text-gray-900">Musyawarah Rencana Pembangunan Desa 2026</h2>
        <p class="mt-2 text-[12px] text-gray-600">Warga diundang hadir untuk memberikan masukan prioritas pembangunan desa.</p>
      </article>

      <article class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4">
        <div class="flex items-center justify-between text-[10px] text-gray-500 uppercase tracking-[0.2em] mb-3">
          <span>Berita</span>
          <span>26 Juli 2026</span>
        </div>
        <h2 class="text-sm font-semibold text-gray-900">Peresmian Posyandu Balita</h2>
        <p class="mt-2 text-[12px] text-gray-600">Posyandu baru resmi dibuka untuk mendukung kesehatan ibu dan anak.</p>
      </article>

      <article class="bg-white rounded-3xl border border-gray-100 shadow-sm p-4">
        <div class="flex items-center justify-between text-[10px] text-gray-500 uppercase tracking-[0.2em] mb-3">
          <span>Info</span>
          <span>22 Juli 2026</span>
        </div>
        <h2 class="text-sm font-semibold text-gray-900">Pembagian Bibit Tanaman Produktif</h2>
        <p class="mt-2 text-[12px] text-gray-600">Program distribusi bibit dijadwalkan untuk seluruh kelompok tani.</p>
      </article>
    </div>

    <a href="/" class="inline-flex items-center justify-center w-full rounded-3xl bg-emerald-700 text-white py-3 text-sm font-semibold hover:bg-emerald-800 transition">Kembali ke Beranda</a>
  </div>
</Layout>
