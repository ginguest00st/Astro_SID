---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Tes Tailwind Desa">
  <main class="p-4 max-w-md mx-auto">
    <!-- Komponen Tes Tailwind -->
    <div class="bg-emerald-600 text-white p-4 rounded-xl shadow-md text-center space-y-2">
      <h1 class="text-lg font-bold">Desa Sukamaju</h1>
      <p class="text-xs text-emerald-100">Tailwind CSS Berhasil Berjalan! 🎉</p>
      <button class="bg-white text-emerald-700 px-3 py-1.5 rounded-lg text-xs font-semibold shadow hover:bg-emerald-50 active:scale-95 transition-all">
        Uji Tombol Mobile
      </button>
    </div>
  </main>
</Layout>